generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Poet {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  bio       String?   @db.Text
  birthDate DateTime?
  deathDate DateTime?
  region    String    @default("آذربایجان") @db.VarChar(50)
  language  String    @default("ترکی") @db.VarChar(20)
  imageUrl  String?   @db.VarChar(255)
  poems     Poem[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("poets")
}

model Poem {
  id         Int         @id @default(autoincrement())
  title      String      @db.VarChar(200)
  content    String      @db.Text
  poet       Poet        @relation(fields: [poetId], references: [id])
  poetId     Int
  audioFiles AudioFile[]
  tags       Tag[]
  comments   Comment[]
  favorites  Favorite[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("poems")
}

model AudioFile {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(255)
  reciter   String   @db.VarChar(100)
  format    String   @default("mp3") @db.VarChar(10)
  duration  Int? // مدت زمان به ثانیه
  poem      Poem     @relation(fields: [poemId], references: [id])
  poemId    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audio_files")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  poems     Poem[]
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name])
  @@map("tags")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique @db.VarChar(255)
  name      String?    @db.VarChar(100)
  password  String     @db.VarChar(255)
  comments  Comment[]
  favorites Favorite[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  poem      Poem     @relation(fields: [poemId], references: [id])
  poemId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  poem      Poem     @relation(fields: [poemId], references: [id])
  poemId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([poemId, userId])
  @@map("favorites")
}
