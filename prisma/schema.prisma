generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Poet {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  bio       String?  @db.Text
  century   String   @db.VarChar(20) // قرن قمری مانند "هشتم"، "سیزدهم"
  poems     Poem[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("poets")
}

model Poem {
  id         Int         @id @default(autoincrement())
  title      String      @db.VarChar(200)
  content    String      @db.Text
  poemType   PoemType // نوع شعر (غزل، قصیده، ...)
  poet       Poet        @relation(fields: [poetId], references: [id])
  poetId     Int
  audioFiles AudioFile[]
  comments   Comment[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("poems")
}

enum PoemType {
  GHAZAL // غزل
  GHASIDEH // قصیده
  ROBBAEI // رباعی
  DOBEITI // دو بیتی
  HEJAI // هجایی
  MASNAVI // مثنوی
  OTHER // سایر
}

model AudioFile {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(255)
  reciter   String   @db.VarChar(100)
  format    String   @default("mp3") @db.VarChar(10)
  duration  Int? // مدت زمان به ثانیه
  poem      Poem     @relation(fields: [poemId], references: [id])
  poemId    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audio_files")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique @db.VarChar(255)
  name      String?   @db.VarChar(100)
  password  String    @db.VarChar(255)
  comments  Comment[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  poem      Poem     @relation(fields: [poemId], references: [id])
  poemId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}
